{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.com/schemas/database-instance.schema.json",
  "title": "Database Instance",
  "description": "Attributes of a database instance (e.g. an Oracle Database). Attributes marked with 'x-enumeration' take their allowed values from the Enumeration Manager application.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "instance_id",
    "instance_name",
    "env",
    "engine",
    "version",
    "host",
    "port",
    "status"
  ],
  "properties": {
    "instance_id": {
      "description": "Unique identifier of the database instance.",
      "type": "string",
      "format": "uuid"
    },
    "instance_name": {
      "description": "Name of the instance (Oracle: ORACLE_SID / instance_name).",
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_]{0,29}$"
    },
    "env": {
      "description": "Deployment environment. Source: Enumeration Manager enumeration 'environment'.",
      "type": "string",
      "enum": ["dev", "uat", "prod"],
      "x-enumeration": "environment"
    },
    "engine": {
      "description": "Database engine.",
      "type": "string",
      "enum": ["oracle", "postgresql", "mysql", "sqlserver", "db2"]
    },
    "version": {
      "description": "Engine version, e.g. 19.21.0.0.0.",
      "type": "string",
      "pattern": "^[0-9]+(\\.[0-9]+)*$"
    },
    "edition": {
      "description": "Engine edition.",
      "type": "string",
      "enum": ["Enterprise Edition", "Standard Edition 2", "Express Edition", "Personal Edition"]
    },
    "host": {
      "description": "Host name or IP address of the server the instance runs on.",
      "type": "string",
      "minLength": 1,
      "maxLength": 253
    },
    "port": {
      "description": "Listener port.",
      "type": "integer",
      "minimum": 1,
      "maximum": 65535,
      "default": 1521
    },
    "service_name": {
      "description": "Oracle service name used for client connections.",
      "type": "string"
    },
    "container": {
      "description": "Multitenant settings (Oracle CDB/PDB).",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "is_cdb": { "type": "boolean", "default": false },
        "pdbs": {
          "description": "Pluggable databases in this container database.",
          "type": "array",
          "uniqueItems": true,
          "items": { "type": "string", "pattern": "^[A-Za-z][A-Za-z0-9_]{0,29}$" }
        }
      }
    },
    "character_set": {
      "description": "Database character set.",
      "type": "string",
      "default": "AL32UTF8"
    },
    "national_character_set": {
      "type": "string",
      "enum": ["AL16UTF16", "UTF8"],
      "default": "AL16UTF16"
    },
    "memory": {
      "description": "Memory allocation in MB.",
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "sga_target_mb": { "type": "integer", "minimum": 0 },
        "pga_aggregate_target_mb": { "type": "integer", "minimum": 0 }
      }
    },
    "storage": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["ASM", "filesystem", "cloud_block_storage"] },
        "allocated_gb": { "type": "number", "minimum": 0 },
        "used_gb": { "type": "number", "minimum": 0 }
      }
    },
    "high_availability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rac_enabled": { "type": "boolean", "default": false },
        "rac_nodes": { "type": "integer", "minimum": 1 },
        "data_guard_role": {
          "type": "string",
          "enum": ["none", "primary", "physical_standby", "logical_standby"],
          "default": "none"
        }
      }
    },
    "backup": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean", "default": true },
        "tool": { "type": "string", "examples": ["RMAN"] },
        "schedule": { "description": "Cron expression.", "type": "string" },
        "retention_days": { "type": "integer", "minimum": 1 },
        "archivelog_mode": { "type": "boolean" }
      }
    },
    "status": {
      "description": "Operational status of the instance.",
      "type": "string",
      "enum": ["provisioning", "running", "stopped", "maintenance", "decommissioned"]
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["team"],
      "properties": {
        "team": { "type": "string" },
        "contact_email": { "type": "string", "format": "email" }
      }
    },
    "tags": {
      "description": "Free-form key/value labels.",
      "type": "object",
      "additionalProperties": { "type": "string" }
    },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "allOf": [
    {
      "if": {
        "properties": { "high_availability": { "properties": { "rac_enabled": { "const": true } }, "required": ["rac_enabled"] } },
        "required": ["high_availability"]
      },
      "then": {
        "properties": { "high_availability": { "required": ["rac_nodes"], "properties": { "rac_nodes": { "minimum": 2 } } } }
      }
    }
  ],
  "examples": [
    {
      "instance_id": "3f2b9c1e-6a7d-4e2f-9b1a-0c8d5e4f7a21",
      "instance_name": "ORCLPRD1",
      "env": "prod",
      "engine": "oracle",
      "version": "19.21.0.0.0",
      "edition": "Enterprise Edition",
      "host": "dbprd01.example.com",
      "port": 1521,
      "service_name": "orclprd.example.com",
      "container": { "is_cdb": true, "pdbs": ["SALESPDB", "HRPDB"] },
      "character_set": "AL32UTF8",
      "national_character_set": "AL16UTF16",
      "memory": { "sga_target_mb": 16384, "pga_aggregate_target_mb": 4096 },
      "storage": { "type": "ASM", "allocated_gb": 2048, "used_gb": 1310.5 },
      "high_availability": { "rac_enabled": true, "rac_nodes": 2, "data_guard_role": "primary" },
      "backup": { "enabled": true, "tool": "RMAN", "schedule": "0 1 * * *", "retention_days": 30, "archivelog_mode": true },
      "status": "running",
      "owner": { "team": "Database Engineering", "contact_email": "dba-team@example.com" },
      "tags": { "cost_center": "CC-1042", "application": "sales-portal" },
      "created_at": "2026-01-15T09:30:00Z",
      "updated_at": "2026-10-20T14:05:00Z"
    }
  ]
}
